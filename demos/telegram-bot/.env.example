# Copy to .env and fill in. Never commit .env or the service-account key.
BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Telegram numeric IDs of the people who receive orders (get yours from @userinfobot)
ADMIN_IDS=111111111,222222222
# Optional: Google Sheet ID (from its URL). Empty = orders kept in memory (testing only)
SHEET_ID=
GOOGLE_CREDENTIALS=service-account.json
TZ_NAME=Africa/Cairo
LOG_FILE=bot.log
